exports[`English output (baseline) > refactor-retry-helper > writes the same rule findings, explanation, and reports > brief.md 1`] = `
"# Covi brief: Extract backoff calculation from the retry loop

Run \`20260901-090000-analyze-0000000\` · refactor-retry-helper · main \`a45ef57\` → HEAD \`4cf4513\` · 3 files, +27 −3 · size small

## Author description

**refactor(http): extract backoff calculation from the retry loop**

> The description is the author’s claim, not evidence. Verify it against the code.

## Commits

- \`4cf4513\` refactor(http): extract backoff calculation from the retry loop

## What Covi determined

- **Intent:** refactor (high confidence). title "refactor(http): extract backoff calculation from the retry loop" uses the refactor prefix; title mentions "extract"; commit "refactor(http): extract backoff calculation from the retry loop"
- **Areas:** http (internal); test (test)
- **Surfaces:** test (1)
- **Demonstration value:** none → text-only. Nothing user-visible changes: no UI, API, or CLI surface is touched, so a written explanation serves reviewers better than a demo.
- **Can run the app:** no
- **Tests:** 1 test file changed (+2 cases); frameworks: node:test

## Suggested reading order

1. \`src/http/backoff.js\`: Adds \`backoffDelay\`.
2. \`src/http/retry.js\`: Changes \`withRetry\`.
3. \`test/backoff.test.js\`: New tests for this change.

## Diff (prioritized)

### src/http/backoff.js · added · +8 −0 · source

\`\`\`diff
@@ -0,0 +1,8 @@
+/**
+ * Delay before retry number \`attempt\` (1-based): exponential growth capped at \`maxMs\`,
+ * with full jitter so concurrent clients do not retry in lockstep.
+ */
+export function backoffDelay(attempt, { baseMs = 100, maxMs = 2000, random = Math.random } = {}) {
+  const ceiling = Math.min(maxMs, baseMs * 2 ** (attempt - 1));
+  return Math.round(random() * ceiling);
+}
\`\`\`

### src/http/retry.js · modified · +4 −3 · source

\`\`\`diff
@@ -1,6 +1,8 @@
+import { backoffDelay } from './backoff.js';
+
 /**
  * Calls \`request\` until it succeeds or \`retries\` attempts fail.
- * Waits between attempts with exponential backoff and full jitter.
+ * Waits between attempts with exponential backoff and full jitter (see backoff.js).
  */
 export async function withRetry(request, { retries = 3, baseMs = 100, maxMs = 2000, random = Math.random, sleep = defaultSleep } = {}) {
   let attempt = 0;
@@ -10,8 +12,7 @@ export async function withRetry(request, { retries = 3, baseMs = 100, maxMs = 20
     } catch (error) {
       attempt++;
       if (attempt > retries || !isRetryable(error)) throw error;
-      const ceiling = Math.min(maxMs, baseMs * 2 ** (attempt - 1));
-      await sleep(Math.round(random() * ceiling));
+      await sleep(backoffDelay(attempt, { baseMs, maxMs, random }));
     }
   }
 }
\`\`\`

### test/backoff.test.js · added · +15 −0 · test

\`\`\`diff
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { backoffDelay } from '../src/http/backoff.js';
+
+test('grows exponentially up to the cap', () => {
+  const max = () => 0.999999;
+  assert.equal(backoffDelay(1, { random: max }), 100);
+  assert.equal(backoffDelay(3, { random: max }), 400);
+  assert.equal(backoffDelay(10, { random: max }), 2000);
+});
+
+test('applies full jitter', () => {
+  assert.equal(backoffDelay(4, { random: () => 0 }), 0);
+  assert.equal(backoffDelay(4, { random: () => 0.5 }), 400);
+});
\`\`\`

## Next steps for the agent

Artifacts live in \`.covi/runs/20260901-090000-analyze-0000000\`.

1. Read the surrounding code for the files above; the diff alone is not enough context.
2. Write \`explanation.json\` (schema: \`covi schema explanation\`) and \`findings.json\` (schema: \`covi schema findings\`) into the run directory.
   Cite the evidence behind each claim in \`evidenceIds\` (\`covi evidence --run 20260901-090000-analyze-0000000\` lists it); confirmed and likely findings cite at least one.
3. Run \`covi report --run 20260901-090000-analyze-0000000\` to validate them and render the Markdown reports.
"
`;

