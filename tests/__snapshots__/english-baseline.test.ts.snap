exports[`English output (baseline) > refactor-retry-helper > drafts the same storyboards and captions > storyboard short 1`] = `
{
  "scenes": [
    {
      "beat": "core",
      "eyebrow": "Extract backoff calculation…",
      "heading": undefined,
      "narration": "Now it extracts backoff calculation from the retry loop in http. The key change is in backoff.js, which adds backoffDelay.",
      "say": "Now it extracts backoff calculation from the retry loop in http. The key change is in the backoff script, which adds backoff delay.",
      "visual": {
        "highlight": [
          4,
          5,
          6,
        ],
        "kind": "code",
        "language": "javascript",
        "lines": [
          {
            "number": 1,
            "text": "/**",
            "type": "add",
          },
          {
            "number": 2,
            "text": " * Delay before retry number \`attempt\` (1-based): exponential growth capped at \`maxMs\`,",
            "type": "add",
          },
          {
            "number": 3,
            "text": " * with full jitter so concurrent clients do not retry in lockstep.",
            "type": "add",
          },
          {
            "number": 4,
            "text": " */",
            "type": "add",
          },
          {
            "number": 5,
            "text": "export function backoffDelay(attempt, { baseMs = 100, maxMs = 2000, random = Math.random } = {})",
            "type": "add",
          },
          {
            "number": 6,
