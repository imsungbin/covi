{
  "schemaVersion": 1,
  "id": "crisp-cli",
  "description": "A crisp, light score for a CLI change: marimba and kalimba over a round bass, rim and shaker.",
  "license": "original",
  "draft": false,
  "bpm": 108,
  "meter": 4,
  "key": "G major",
  "tracks": {
    "keys": { "patch": "marimba", "gain": -15, "pan": -0.1, "reverb": 0.2 },
    "pluck": { "patch": "kalimba", "gain": -18, "pan": 0.2, "delay": 0.2, "reverb": 0.25 },
    "bass": { "patch": "round-bass", "gain": -14 },
    "kit": { "kit": "soft-electro", "gain": -16 }
  },
  "fx": { "delay": { "time": "3/16", "feedback": 0.25 }, "reverb": { "size": 0.6, "damp": 0.5 } },
  "patterns": {
    "keys_a": {
      "chords": "Gadd9 | Em7 | Cmaj7 | D6sus",
      "voicing": ["G3", "G4"],
      "rhythm": "x..x..x.",
      "rhythmStep": "1/8",
      "gate": 0.5,
      "velocity": 0.55
    },
    "keys_lift": {
      "chords": "Cmaj9 | D",
      "voicing": ["G3", "A4"],
      "rhythm": "x.x.x.x.",
      "rhythmStep": "1/8",
      "gate": 0.5,
      "velocity": 0.65
    },
    "keys_end": { "chords": "Gadd9 | -", "voicing": ["G3", "G4"], "velocity": 0.5 },
    "keys_open": { "chords": "Dsus4 | -", "voicing": ["G3", "G4"], "velocity": 0.5 },
    "keys_minor": { "chords": "Em7 | -", "voicing": ["G3", "G4"], "velocity": 0.45 },
    "pluck_lift": {
      "arp": "keys_lift",
      "steps": "0 2 1 3 2 4 3 1'",
      "step": "1/8",
      "octave": 5,
      "velocity": 0.5
    },
    "bass_a": {
      "notes": "G2 . . . . . D2 . | E2 . . . . . B1 . | C2 . . . . . G2 . | D2 . . . A2 . . .",
      "step": "1/8",
      "velocity": 0.75
    },
    "bass_end": { "notes": "G2 . . . . . . . | - - - - - - - -", "step": "1/8" },
    "kit_a": {
      "drums": {
        "kick": "x.......x.......",
        "rim": "....x.......x...",
        "shaker": "..g...g...g...g."
      },
      "step": "1/16",
      "velocity": 0.55
    },
    "kit_end": {
      "drums": { "kick": "x...............|................" },
      "step": "1/16",
      "velocity": 0.55
    }
  },
  "sections": {
    "a": { "bars": 4, "play": ["keys_a", "bass_a", "kit_a"] },
    "lift": { "bars": 2, "play": ["keys_lift", "pluck_lift", "bass_a", "kit_a"], "accent": true },
    "resolved": { "bars": 2, "play": ["keys_end", "bass_end", "kit_end"] },
    "open": { "bars": 2, "play": ["keys_open", "kit_end"] },
    "minor": { "bars": 2, "play": ["keys_minor", "kit_end"] }
  },
  "form": {
    "loop": ["a"],
    "hero": "lift",
    "ending": { "looks-good": "resolved", "needs-attention": "open", "needs-changes": "minor" },
    "logo": { "track": "pluck", "octave": 5, "double": "keys" }
  }
}
