- \`b3c73b6\` feat(api): paginate GET /api/users

## What Covi determined

- **Intent:** feature (high confidence). title "feat(api): paginate GET /api/users" uses the feat prefix; commit "feat(api): paginate GET /api/users"; branch name "feat/users-pagination"
- **Areas:** app.js (api)
- **Surfaces:** api (1)
- **Demonstration value:** high (api) → video. API routes change: GET /api/users.
- **Can run the app:** yes (command)
- **Tests:** no test changes; frameworks: node:test
- **Environment variables:** USERS_PAGE_SIZE (added)

## Signals worth checking

- **[missing-tests-01e4a91d1b29]** Risk worth checking · low: Behavior change without tests (\`app.js\`)
- **[env-var-undocumented-fb3333296776]** Risk worth checking · low: New environment variable USERS_PAGE_SIZE is not documented (\`app.js:3\`)
- New environment variable USERS_PAGE_SIZE (not documented). (\`app.js:3\`)

Rule findings are evidence-based but shallow. Confirm or dismiss each one (with a reason) in findings.json.

## Suggested reading order

1. \`app.js\`: Route modified: \`GET /api/users\`.

## Diff (prioritized)

### app.js · modified · +14 −1 · source

\`\`\`diff
@@ -1,5 +1,16 @@
 import { USERS } from './users.js';
 
+const PAGE_SIZE = Number(process.env.USERS_PAGE_SIZE ?? 2);
+
+/** Returns one page of users starting after \`cursor\` (a user id). */
+function pageOfUsers(cursor, limit) {
+  const start = cursor ? USERS.findIndex((u) => u.id === cursor) + 1 : 0;
+  const items = USERS.slice(start, start + limit);
+  const last = items.at(-1);
+  const hasMore = start + limit < USERS.length;
+  return { items, nextCursor: hasMore && last ? last.id : null };
+}
+
 export function handle(req, res) {
   const url = new URL(req.url, 'http://localhost');
   if (url.pathname === '/health') {
@@ -7,8 +18,10 @@ export function handle(req, res) {
     return;
   }
   if (req.method === 'GET' && url.pathname === '/api/users') {
+    const limit = Math.min(Number(url.searchParams.get('limit') ?? PAGE_SIZE), 50);
+    const cursor = url.searchParams.has('cursor') ? Number(url.searchParams.get('cursor')) : undefined;
     res.writeHead(200, { 'content-type': 'application/json' });
-    res.end(JSON.stringify(USERS));
+    res.end(JSON.stringify(pageOfUsers(cursor, limit)));
     return;
   }
   res.writeHead(404, { 'content-type': 'application/json' }).end(JSON.stringify({ error: 'not found' }));
